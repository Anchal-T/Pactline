{
  "name": "@pactline/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env --import tsx scripts/cli.ts migrate",
    "db:seed": "node --env-file=../../.env --import tsx scripts/cli.ts seed",
    "db:setup": "node --env-file=../../.env --import tsx scripts/cli.ts setup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout 30000"
  },
  "dependencies": {
    "@pactline/domain": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@pactline/typescript-config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
