# ── Database ──────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/pactline?sslmode=require"

# ── LLM Gateway ───────────────────────────────────────────
# OpenAI-compatible base URL (Cloudflare AI Gateway or direct)
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="sk-..."

# Model IDs (role-tiered — per AGENTS.md)
LLM_MODEL_EXTRACTION="gpt-4o-mini"      # cheap/fast: spec extraction, structured parsing
LLM_MODEL_INVESTIGATION="gpt-4o"        # medium: root-cause investigation
LLM_MODEL_OPERATOR="gpt-4o"            # high: operator decisions, recovery planning

# ── MCP Server ────────────────────────────────────────────
MCP_SERVER_PORT=3100

# ── App ───────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
